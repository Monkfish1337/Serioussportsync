# Copy to .env in the Dockge stack directory and chmod 600.
# Preserve the values of existing secrets; do not generate replacements during
# the stack move or existing SSS sessions/encrypted settings may stop working.

# Current SSS names. Copy the value of the old SSS_SESSION_SECRET here.
SESSION_SECRET=
SCRAPER_AUTH_TOKEN=

# Public addon and account settings.
PUBLIC_URL=https://serioussportsync.monkfish.win
ADMIN_USER=
ADDON_TYPE=movie

# Metadata.
TSDB_API_KEY=123
TSDB_SEASONS=auto
FOOTBALL_DATA_API_KEY=
TMDB_API_KEY=
EVENT_WINDOW_DAYS_BACK=30
EVENT_WINDOW_DAYS_AHEAD=90
REFRESH_INTERVAL_HOURS=6
WIKIPEDIA_ENRICH=on

# Optional direct discovery. The companion is always connected internally at
# http://serioussportsync-scraper:8080 by compose.yaml.
PROWLARR_URL=http://gluetun:9696
PROWLARR_API_KEY=
ZILEAN_URL=http://zilean:8181
COMPANION_TIMEOUT_MS=30000
AUTO_CACHE_ON_MISS=on

# Current admin power-tool names. Copy old WARMER_* values if used.
ADMIN_TB_TOKEN=
ADMIN_PM_KEY=

# Stream request tuning.
STREAM_MAX_ROWS=20
STREAM_PIPELINE_TIMEOUT_MS=30000
WARM_MAX_ROWS=5
WARM_RATE_LIMIT_COUNT=5
WARM_RATE_LIMIT_WINDOW_SEC=3600
LOG_EXCLUDED_TITLES=1

# Companion runtime. The current defaults replace the old 45000 ms source
# timeout, which exceeded the overall 25000 ms scrape budget.
SOURCE_TIMEOUT_MS=10000
SCRAPE_BUDGET_MS=25000
LOG_BUFFER_MAX=4000
HISTORY_MAX=200

# Preserve Gluetun routing while both containers live in this separate stack.
GLUETUN_HTTP_PROXY=http://gluetun:8888
INTERNAL_NO_PROXY=localhost,127.0.0.1,gluetun,prowlarr,zilean,serioussportsync,serioussportsync-scraper
STREMIO_NETWORK=stremio-stack_stremio-net

# Existing bind mounts are retained for a zero-copy first migration. Override
# only after making and verifying a separate backup.
SSS_DATA_PATH=/mnt/storage/stremio-stack/serioussportsync-data
SCRAPER_DATA_PATH=/mnt/storage/stremio-stack/serioussportsync-scraper/data

# Host-published ports stay loopback-only. Cloudflare reaches SSS by its
# container name on stremio-net; the scraper GUI must never be public.
SSS_BIND_ADDRESS=127.0.0.1
SSS_HOST_PORT=7000
SCRAPER_BIND_ADDRESS=127.0.0.1
SCRAPER_HOST_PORT=8180
