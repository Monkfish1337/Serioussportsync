# SeriousSportSync — minimal Docker Compose configuration
# Copy this file to .env. Only SESSION_SECRET is required.

# Required: signs sessions and encrypts stored provider credentials.
# Generate with `openssl rand -hex 32` or the PowerShell command in
# docs/INSTALLATION.md.
# Keep this value when updating or moving the installation.
SESSION_SECRET=

# Optional: this username becomes administrator when it signs up.
ADMIN_USER=admin

# The supplied Compose file is host-only by default. To open SSS from another
# device, set this to the server's LAN IP (preferred) or 0.0.0.0 (all adapters).
# Do not expose port 7000 directly to the Internet.
# SSS_BIND_ADDRESS=192.168.1.10
# SSS_HOST_PORT=7000

# Set a fixed public URL only when automatic install URLs are wrong.
# PUBLIC_URL=https://sports.example.com
# TRUST_PROXY=1

# Optional server-wide discovery. These can also be configured in Admin.
# COMPANION_URL=http://serioussportsync-scraper:8080
# COMPANION_AUTH_TOKEN=
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=

# Optional outbound proxy. Keep local services in NO_PROXY.
# HTTPS_PROXY=http://gluetun:8888
# HTTP_PROXY=http://gluetun:8888
# NO_PROXY=localhost,127.0.0.1,serioussportsync-scraper,prowlarr

# SSS already supplies safe defaults for metadata, playback budgets, the event
# window, and Smart Availability. See docs/CONFIGURATION.md before overriding
# them. Per-user TorBox, Easynews, UU, NZB DAV, and NNTP credentials belong on
# the signed-in Account page, not in this file.
