{
    "name":  "serioussportsync",
    "version": "0.43.0",
    "description":  "Self-hosted Stremio/Nuvio sports metadata calendar with optional per-user TorBox, Usenet Ultimate, and Easynews playback pipelines.",
    "main":  "server.js",
    "scripts":  {
                    "start":  "node server.js",
                    "refresh":  "node scripts/refresh.js",
                    "refresh-streams":  "node scripts/refresh-streams.js",
                    "gen-token":  "node scripts/gen-token.js",
                    "dev":  "node server.js"
                },
    "keywords":  [
                     "stremio",
                     "stremio-addon",
                     "sports",
                     "ufc",
                     "mma",
                     "wwe",
                     "aew",
                     "torbox",
                     "prowlarr",
                     "usenet",
                     "newznab",
                     "easynews",
                     "metadata"
                 ],
    "license":  "MIT",
    "dependencies":  {
                         "bcryptjs":  "^2.4.3",
                         "express":  "^4.19.2",
                         "node-fetch":  "^2.7.0",
                         "https-proxy-agent":  "^7.0.2"
                     },
    "engines":  {
                    "node":  "\u003e=18"
                }
}
